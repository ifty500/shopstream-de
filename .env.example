# Postgres (used by the postgres container, the pipeline and dbt)
POSTGRES_USER=shopstream
POSTGRES_PASSWORD=change_me
POSTGRES_DB=shopstream
POSTGRES_HOST=postgres        # service name inside the Docker network
POSTGRES_PORT=5432
EXTERNAL_POSTGRES_PORT=5437   # port exposed on your machine

# dbt (optional: each falls back to the POSTGRES_* value above)
DBT_TARGET=dev
# DBT_HOST=
# DBT_USER=
# DBT_PASSWORD=
# DBT_DBNAME=
# DBT_PORT=

# Metabase admin account created by `make dashboard` (dev only)
MB_ADMIN_EMAIL=admin@shopstream.local
MB_ADMIN_PASSWORD=ShopStream-dev-1

# Host port for dbt docs (make docs)
DBT_DOCS_PORT=8081
